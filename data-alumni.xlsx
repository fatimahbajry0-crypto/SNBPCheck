  };
}

// ANALISIS NILAI RAPOR
function analyzePrediction(data) {

  const nilai = [
    Number(data.semester1),
    Number(data.semester2),
    Number(data.semester3),
    Number(data.semester4),
    Number(data.semester5)
  ];

  if (nilai.some(n => !Number.isFinite(n) || n < 0 || n > 100)) {
    throw new Error('Nilai semester harus berada di antara 0 sampai 100.');
  }

  const rataRata = nilai.reduce((a, b) => a + b, 0) / 5;

  let kategori = '';
  let keterangan = '';

  if (rataRata >= 90) {
    kategori = 'Nilai akademik tinggi';
    keterangan = 'Nilai rapor kamu tergolong tinggi. Tetap perhatikan peringkat eligible, prestasi, dan persaingan program studi.';
  } else if (rataRata >= 85) {
    kategori = 'Nilai akademik cukup kompetitif';
    keterangan = 'Nilai rapor kamu dapat menjadi modal untuk menyusun pilihan program studi secara strategis.';
  } else if (rataRata >= 80) {
    kategori = 'Perlu strategi pemilihan';
    keterangan = 'Pertimbangkan kesesuaian nilai mata pelajaran pendukung dan data penerimaan alumni.';
  } else {
    kategori = 'Perlu evaluasi akademik';
    keterangan = 'Evaluasi nilai rapor dan konsultasikan strategi pilihan dengan guru BK.';
  }

  let posisi = 'Belum diisi';

  const peringkat = Number(data.peringkat);
  const jumlahEligible = Number(data.jumlahEligible);

  if (
    Number.isInteger(peringkat) &&
    Number.isInteger(jumlahEligible) &&
    peringkat > 0 &&
    jumlahEligible > 0 &&
    peringkat <= jumlahEligible
  ) {
    const rasio = peringkat / jumlahEligible;

    if (rasio <= 0.2) {
      posisi = '20% teratas siswa eligible';
    } else if (rasio <= 0.5) {
      posisi = 'Di luar 20% teratas';
    } else {
      posisi = 'Bagian bawah kelompok eligible';
    }
  }

  return {
    rataRata: rataRata.toFixed(2),
    kategori: kategori,
    keterangan: keterangan,
    posisi: posisi,
    pilihan1: data.pilihan1 || '-',
    pilihan2: data.pilihan2 || '-'
  };
}

// MENYIMPAN HASIL SIMULASI KE GOOGLE SHEETS
// Hanya dilakukan jika siswa menyetujui penyimpanan.
function savePrediction(data) {

  const result = analyzePrediction(data);

  const ss = SpreadsheetApp.getActiveSpreadsheet();

  let sheet = ss.getSheetByName('DATA SIMULASI');

  if (!sheet) {
    sheet = ss.insertSheet('DATA SIMULASI');

    sheet.appendRow([
      'Waktu',
      'Tahun Seleksi',
      'Rata-rata Rapor',
      'Peringkat Eligible',
      'Jumlah Eligible',
      'Kategori Nilai',
      'Pilihan 1',
      'Pilihan 2'
    ]);
  }

  sheet.appendRow([
    new Date(),
    data.tahun || '',
    result.rataRata,
    data.peringkat || '',
    data.jumlahEligible || '',
    result.kategori,
    result.pilihan1,
    result.pilihan2
  ]);

  return 'Data simulasi berhasil disimpan.';
}
